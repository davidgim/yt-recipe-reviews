# API Configuration
REACT_APP_API_URL=https://recipe-review-backend-api.herokuapp.com
REACT_APP_ENVIRONMENT=production

# Feature Flags
REACT_APP_ENABLE_ERROR_REPORTING=true
REACT_APP_ENABLE_ANALYTICS=true

# Cache Configuration
REACT_APP_CACHE_DURATION_MINUTES=60

# Security
REACT_APP_CSP_REPORT_URI=https://recipe-review-backend-api.herokuapp.com/csp-report 